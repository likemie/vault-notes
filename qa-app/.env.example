# Gemini API Key (在 Google AI Studio 创建并绑定 Cloud Billing 账号)
GEMINI_API_KEY=

# Gemini File Search Store 资源名（运行 npm run sync 后会自动生成或可手动填入）
# 格式示例: fileSearchStores/xxxxxxxxxxxxxxxxxxxx
FILE_SEARCH_STORE_NAME=

# 默认使用的对话模型（可通过前端切换）
GEMINI_MODEL=gemini-3.8-flash

# 可选：为独立在线应用设置访问密码，留空则不启用密码验证
APP_ACCESS_PASSWORD=

# 可选：Quartz 公开站点前缀（若填写，检索出的条目路径会渲染为可点击链接）
# 示例: https://likemie.github.io
QUARTZ_BASE_URL=

# 服务端口（AI Studio 预览默认 3000；Cloud Run 部署会自动注入 PORT=8080）
PORT=3000
