.DS_Store
__pycache__/
*.py[cod]
scripts/*.bak
scripts/.backup/
.venv/
.pytest_cache/
output/link-exceptions.lock
scratch/
tmp/

# Local text extraction and drafting intermediates.
.pdf_text_dump.txt
.system_generated_full_paper.txt
cleaned_paper.txt
extracted_paper.txt
scratch_*.txt

# Keep local PDF reading copies out of git; PDFs are served from NAS.
sources/**/*.pdf
sources/**/*.PDF
books/**/*.pdf
books/**/*.PDF
books/**/*.epub
books/**/*.EPUB

# Office / Word lock & temporary files
~$*
*.tmp

# Local Claude Code settings (machine-specific)
.claude/settings.local.json

# Personal files (signature etc.), never pushed.
private/

# Local datasets, generated output, and accidental home-directory copies.
/datasets/
/output/
/Users/
