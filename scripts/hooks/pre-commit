#!/bin/sh
# Vault pre-commit hook: refresh base indexes and block commits with lint errors.
# Install (once): git config --local core.hooksPath scripts/hooks
set -e
cd "$(git rev-parse --show-toplevel)"

PY=".venv/bin/python3"
[ -x "$PY" ] || PY="python3"

echo "[pre-commit] vault_index.py (base index)..."
"$PY" scripts/vault_index.py >/dev/null

# Re-stage generated surfaces so the commit stays consistent.
git add wiki/index.json wiki/index.md \
    wiki/concepts/index.md wiki/theories/index.md wiki/methods/index.md \
    wiki/instruments/index.md wiki/persons/index.md wiki/facts/index.md \
    wiki/arguments/index.md citation/citation_full.json citation/citation_ambiguous.json

echo "[pre-commit] journal naming, index consistency, citations, and incremental lint..."
if ! "$PY" scripts/vault_lint.py; then
    echo ""
    echo "[pre-commit] validation failed - commit blocked."
    echo "[pre-commit] fix mechanical issues with: $PY scripts/vault_lint.py --fix"
    echo "[pre-commit] bypass once with: git commit --no-verify"
    exit 1
fi
echo "[pre-commit] ok"
